use core::*;
use core::types::*;
use core::intrinsics::*;

pub trait T: Cmp {
    fn cmp(self: &T, other: &T) -> i32;
}

#[extern]
fn strcmp(a: c_str, b: c_str) -> i32;
impl c_str: Cmp {
    pub fn cmp(self: &c_str, other: &c_str) -> i32 {
        strcmp(*self, *other)
    }
}

impl bool: Cmp { pub fn cmp(self: &bool, other: &bool) -> bool { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }

impl i8: Cmp { pub fn cmp(self: &i8, other: &i8) -> i32 { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }
impl i16: Cmp { pub fn cmp(self: &i16, other: &i16) -> i32 { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }
impl i32: Cmp { pub fn cmp(self: &i32, other: &i32) -> i32 { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }
impl i64: Cmp { pub fn cmp(self: &i64, other: &i64) -> i32 { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }
impl i128: Cmp { pub fn cmp(self: &i128, other: &i128) -> i32 { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }
impl isize: Cmp { pub fn cmp(self: &isize, other: &isize) -> i32 { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }

impl u8: Cmp { pub fn cmp(self: &u8, other: &u8) -> i32 { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }
impl u16: Cmp { pub fn cmp(self: &u16, other: &u16) -> i32 { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }
impl u32: Cmp { pub fn cmp(self: &u32, other: &u32) -> i32 { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }
impl u64: Cmp { pub fn cmp(self: &u64, other: &u64) -> i32 { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }
impl u128: Cmp { pub fn cmp(self: &u128, other: &u128) -> i32 { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }
impl usize: Cmp { pub fn cmp(self: &usize, other: &usize) -> i32 { if *self < *other { return 0-1; }; if *self > *other { return 1; }; 0 } }
