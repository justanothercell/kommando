use core::*;
use core::types::*;
use core::intrinsics::*;

pub trait H: Hasher {
    fn digest(self: &H, data: u8);
    fn digest_bytes(self: &H, bytes: &u8, length: usize);
    fn digest_bytes_of<T>(self: &H, item: &T);
    fn finish(self: &H) -> u64;
}

const FNV1a_OFFSET_BASIS: u64 = 0xcbf29ce484222325;
const FNV1a_PRIME: u64 = 0x100000001b3;

pub struct FNV1aHasher {
    hash: u64
}

pub use FNV1aHasher as DefaultHasher;

impl FNV1aHasher: Hasher {
    fn digest(self: &FNV1aHasher, data: u8) {
        self.hash ^= numcast(data);
        self.hash *= FNV1a_PRIME;
    }
    fn digest_bytes(self: &FNV1aHasher, bytes: &u8, length: usize) {
        let base: usize = typecast(bytes);
        let offset: usize = 0;
        while offset < length {
            self.digest(*typecast::<_, &u8>(base + offset));
            offset += 1;
        }
    }
    fn digest_bytes_of<T>(self: &FNV1aHasher, item: &T) {
        let item: &u8 = typecast::<&T, &u8>(item);
        let size = sizeof::<T>();
        self.digest_bytes(item, size);
    }
    fn finish(self: &FNV1aHasher) -> u64 {
        self.hash
    }
}

impl FNV1aHasher {
    fn new() -> FNV1aHasher {
        FNV1aHasher::<>::new_with_key(0)
    }

    fn new_with_key(key: u64) -> FNV1aHasher {
        _ { hash: FNV1a_OFFSET_BASIS ^ key }
    }
}

pub trait T: Hash {
    fn hash<H: Hasher>(self: &T, hasher: &H);
}

#[extern]
fn strlen(s: c_str) -> usize;
impl c_str: Hash {
    pub fn hash<H: Hasher>(self: &c_str, hasher: &H) {
        let len = strlen(*self);
        hasher.digest_bytes_of(&len);
        hasher.digest_bytes(typecast(*self), len);
    }
}

impl bool: Hash { pub fn hash<H: Hasher>(self: &bool, hasher: &H) { hasher.digest_bytes_of(self) } }
impl raw_ptr: Hash { pub fn hash<H: Hasher>(self: &raw_ptr, hasher: &H) { hasher.digest_bytes_of(self) } }

impl i8: Hash { pub fn hash<H: Hasher>(self: &i8, hasher: &H) { hasher.digest_bytes_of(self) } }
impl i16: Hash { pub fn hash<H: Hasher>(self: &i16, hasher: &H) { hasher.digest_bytes_of(self) } }
impl i32: Hash { pub fn hash<H: Hasher>(self: &i32, hasher: &H) { hasher.digest_bytes_of(self) } }
impl i64: Hash { pub fn hash<H: Hasher>(self: &i64, hasher: &H) { hasher.digest_bytes_of(self) } }
impl i128: Hash { pub fn hash<H: Hasher>(self: &i128, hasher: &H) { hasher.digest_bytes_of(self) } }
impl isize: Hash { pub fn hash<H: Hasher>(self: &isize, hasher: &H) { hasher.digest_bytes_of(self) } }

impl u8: Hash { pub fn hash<H: Hasher>(self: &u8, hasher: &H) { hasher.digest_bytes_of(self) } }
impl u16: Hash { pub fn hash<H: Hasher>(self: &u16, hasher: &H) { hasher.digest_bytes_of(self) } }
impl u32: Hash { pub fn hash<H: Hasher>(self: &u32, hasher: &H) { hasher.digest_bytes_of(self) } }
impl u64: Hash { pub fn hash<H: Hasher>(self: &u64, hasher: &H) { hasher.digest_bytes_of(self) } }
impl u128: Hash { pub fn hash<H: Hasher>(self: &u128, hasher: &H) { hasher.digest_bytes_of(self) } }
impl usize: Hash { pub fn hash<H: Hasher>(self: &usize, hasher: &H) { hasher.digest_bytes_of(self) } }
