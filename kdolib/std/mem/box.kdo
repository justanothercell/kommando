use std::*;

use core::clone::Clone;
use core::drop::Drop;

pub struct Box<T> {
    item: &T
}

impl<T> Box<T> {
    pub fn new(t: T) -> Box<T> {
        _ { item: std::mem::new(t) }
    }
    pub fn ref(self: &Box<T>) -> &T {
        self.item
    }
}

impl<T: Clone> Box<T>: Clone {
    pub fn clone(self: &Box<T>) -> Box<T> {
        Box::<T>::new(self.item.clone())
    }
}

impl<T> Box<T>: Drop {
    pub fn drop(self: &Box<T>) {
        std::mem::free(self.item)
    }
}