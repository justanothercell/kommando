use std::*;

use core::clone::Clone;
use core::drop::Drop;

struct RcInner<T> {
    item: T,
    count: usize
}

pub struct Rc<T> {
    inner: &RcInner<T>
}

impl<T> Rc<T> {
    pub fn new(t: T) -> Rc<T> {
        _ { inner: std::mem::new(_ { item: t, count: 1 }) }
    }

    pub fn ref(self: &Rc<T>) -> &T {
        &self.inner.item
    }
}

impl<T> Rc<T>: Clone {
    pub fn clone(self: &Rc<T>) -> Rc<T> {
        self.inner.count += 1;
        _ { inner: self.inner }
    }
}

impl<T> Rc<T>: Drop {
    pub fn drop(self: &Rc<T>) {
        self.inner.count -= 1;
        if self.inner.count == 0 {
            std::mem::drop(std::mem::take_unchecked(&self.inner.item));
            std::mem::free(self.inner);
        }
    }
}