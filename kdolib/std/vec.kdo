use std::*;
use std::slice::Slice;
use core::copy::Copy;
use core::clone::Clone;
use core::drop::Drop;
use std::iter::Iter;

pub struct Vec<T> {
    length: usize,
    capacity: usize,
    buffer: &T
}

impl<T> Vec<T> {
    pub fn new() -> Vec<T> {
        Vec::<T>::new_with(0)
    }

    pub fn new_with(capacity: usize) -> Vec<T> {
        _ {
            length: 0,
            capacity: capacity,
            buffer: std::mem::arr_new(capacity)
        }
    }

    fn reserve_armortized(v: &Vec<T>, size: usize) {
        if v.capacity >= size { return; };
        if v.capacity == 0 { v.capacity = 8; };
        while v.capacity < size {
            v.capacity *= 2;
        };
        v.buffer = std::mem::arr_resize(v.buffer, v.capacity);
    }

    pub fn push(v: &Vec<T>, item: T) {
        v.reserve_armortized(v.length + 1);
        *std::mem::arr_offset(v.buffer, v.length) = item;
        v.length += 1;
    }

    pub fn get_ref(v: &Vec<T>, i: usize) -> Option<&T> {
        if i < v.length {
            Option::<_>::some(std::mem::arr_offset(v.buffer, i))
        } else {
            Option::<_>::none()
        }
    }
    pub fn last_ref(v: &Vec<T>) -> Option<&T> {
        if v.length == 0 {
            return Option::<_>::none();
        };
        v.get_ref(v.length - 1)
    }

    pub fn pop(v: &Vec<T>) -> Option<T> {
        if v.length > 0 {
            v.length -= 1;
            Option::<_>::some(std::mem::arr_take_unchecked(v.buffer, v.length))
        } else {
            Option::<_>::none()
        }
    }

    pub fn swap_remove(v: &Vec<T>, index: usize) -> Option<T> {
        if index >= v.length {
            return Option::<_>::none();
        };
        if index < v.length - 1 {
            std::mem::swap(
                std::mem::arr_offset(v.buffer, index),
                std::mem::arr_offset(v.buffer, v.length - 1)
            );
        };
        v.length -= 1;
        Option::<_>::some(std::mem::arr_take_unchecked(v.buffer, v.length))
    }

    pub fn remove(v: &Vec<T>, index: usize) -> Option<T> {
        if index >= v.length {
            return Option::<_>::none();
        };
        let item = std::mem::arr_take_unchecked(v.buffer, index);
        v.length -= 1;
        while index < v.length {
            std::mem::swap(
                std::mem::arr_offset(v.buffer, index),
                std::mem::arr_offset(v.buffer, index+1)
            );
            index += 1;
        };
        Option::<_>::some(item)
    }

    pub fn clear(v: &Vec<T>) {
        v.length = 0;
    }

    pub fn slice(v: &Vec<T>) -> Slice<T> {
        v.slice_range(0, v.length)
    }

    pub fn slice_range(v: &Vec<T>, from: usize, to: usize) -> Slice<T> {
        if to < from { panic("Slice range negative") };
        if v.length < to { panic("Slice out of range for vector") };
        _ { buffer: std::mem::arr_offset(v.buffer, from), length: to - from }
    }

    pub fn collect<I: Iter<T>>(iter: I) -> Vec<T> {
        let v = Vec::<T>::new();
        let next = iter.next();
        while next.is_some() {
            v.push(next.unwrap());
            next = iter.next();
        };
        v
    }

    pub fn iter(self: &Vec<T>) -> std::slice::SliceIter<T> {
        self.slice().iter()
    }
}

impl<T: Copy> Vec<T> {
    pub fn copy_iter(self: &Vec<T>) -> std::slice::SliceCopyIter<T> {
        self.slice().copy_iter()
    }
}

impl<T: Copy> Vec<T> {
    pub fn join<I: Iter<Slice<T>>>(iter: I) -> Vec<T> {
        let v = Vec::<T>::new();
        let next = iter.next();
        while next.is_some() {
            let slice = next.unwrap();
            let index = 0usize;
            while index < slice.length {
                v.push(slice.get(index).unwrap());
                index += 1;
            };
        };
        v
    }
    pub fn join_with<I: Iter<Slice<T>>>(iter: I, delimeter: T) -> Vec<T> {
        let v = Vec::<T>::new();
        let next = iter.next();
        while next.is_some() {
            if v.length > 0 {
                v.push(delimeter);
            };
            let slice = next.unwrap();
            let index = 0usize;
            while index < slice.length {
                v.push(slice.get(index).unwrap());
                index += 1;
            };
        };
        v
    }
    pub fn join_with_slice<I: Iter<Slice<T>>>(iter: I, delimeter: Slice<T>) -> Vec<T> {
        let v = Vec::<T>::new();
        let next = iter.next();
        while next.is_some() {
            if v.length > 0 {
                let index = 0usize;
                while index < delimeter.length {
                    v.push(delimeter.get(index).unwrap());
                    index += 1;
                };
            };
            let slice = next.unwrap();
            let index = 0usize;
            while index < slice.length {
                v.push(slice.get(index).unwrap());
                index += 1;
            };
            next = iter.next();
        };
        v
    }
}

impl Vec<char> {
    // Appends a zero terminator but does not increase length.
    // That way the teminator can be overridden on future appends.
    pub fn as_str(v: &Vec<char>) -> c_str {
        v.reserve_armortized(v.length + 1); // zero terminator
        *std::mem::arr_offset(v.buffer, v.length) = 0; // we append zero terminator but we do not increase length
        typecast(v.buffer)
    }

    fn dyn_fmt_str(s: &Vec<char>) -> DynFmt {
        _ { object: typecast(s), fmt: Vec::<char>::fmt_str }
    }
    fn fmt_str(s: &Vec<char>, fmt: &Formatter, stream: &FormatStream) {
        let i = 0usize;
        while i < s.length {
            stream.write_char(s.get(i).unwrap());
            i += 1;
        };
    }
}

use std::fmt::*;

impl<T: Fmt> Vec<T>: Fmt {
    fn dyn_fmt(v: &Vec<T>) -> DynFmt {
        _ { object: typecast(v), fmt: Vec::<T>::fmt }
    }
    fn fmt(v: &Vec<T>, fmt: &Formatter, stream: &FormatStream) {
        v.slice().fmt(fmt, stream);
    }
}

impl<T: Copy> Vec<T> {
    pub fn last(v: &Vec<T>) -> Option<T> {
        if v.length == 0 {
            return Option::<_>::none();
        };
        v.get(v.length - 1)
    }
    
    pub fn get(v: &Vec<T>, i: usize) -> Option<T> {
        if i < v.length {
            Option::<_>::some(*std::mem::arr_offset(v.buffer, i))
        } else {
            Option::<_>::none()
        }
    }
}

impl<T: Clone> Vec<T>: Clone {
    fn clone(self: &Vec<T>) -> Vec<T> {
        let cloned = Vec::<T>::new_with(self.capacity);
        while cloned.length < self.length {
            cloned.push(self.get_ref(cloned.length).unwrap().clone());
        };
        cloned
    }
}

impl<T> Vec<T>: Drop {
    fn drop(self: &Vec<T>) {
        let i = 0usize;
        while i < self.length {
            std::mem::arr_take_unchecked(self.buffer, i); // drops item
            i += 1;
        };
        std::mem::free(self.buffer);
    }
}