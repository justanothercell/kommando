use std::*;
use std::io::stderr;
use core::intrinsics::typeid;
use core::intrinsics::typename;

pub struct Any {
    tid: TypeId,
    object: raw_ptr
}

impl Any: core::copy::Copy {}

impl Any {
    pub fn from<T>(object: &T) -> Any {
        _ {
            tid: typeid::<T>(),
            object: typecast(object)
        }
    }

    pub fn is<T>(self: Any) -> bool {
        typeid::<T>() == self.tid
    }

    pub fn as<T>(self: Any) -> &T {
        if self.is::<T>() {
            typecast(self.object)
        } else {
            panic(format( "ERROR: cannot interpret this `Any` object as $", typename::<T>().dyn_fmt()))
        }
    }

    pub fn try_as<T>(self: Any) -> Option<&T> {
        if self.is::<T>() {
            Option::<_>::some(typecast(self.object))
        } else {
            Option::<_>::none()
        }
    }
}
