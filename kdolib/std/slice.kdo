use std::*;
use std::vec::Vec;
use std::iter::Iter;

use core::copy::Copy;
use core::clone::Clone;
use core::cmp::Cmp;

pub struct Slice<T> {
    length: usize,
    buffer: &T
}

impl<T> Slice<T>: Copy {}

pub struct SliceIter<T> {
    length: usize, 
    index: usize,
    buffer: &T
}

impl<T> SliceIter<T>: Iter<&T> {
    fn next(self: &SliceIter<T>) -> Option<&T> {
        if self.index < self.length {
            Option::<_>::some(std::mem::arr_offset(self.buffer, std::mem::replace(&self.index, self.index+1)))
        } else {
            Option::<_>::none()
        }
    }
}

pub struct SliceCopyIter<T> {
    length: usize, 
    index: usize,
    buffer: &T
}

impl<T: Copy> SliceCopyIter<T>: Iter<T> {
    fn next(self: &SliceCopyIter<T>) -> Option<T> {
        if self.index < self.length {
            Option::<_>::some(*std::mem::arr_offset(self.buffer, std::mem::replace(&self.index, self.index+1)))
        } else {
            Option::<_>::none()
        }
    }
}

impl<T> Slice<T> {
    pub fn get_ref(s: &Slice<T>, i: usize) -> Option<&T> {
        if i < s.length {
            Option::<_>::some(std::mem::arr_offset(s.buffer, i))
        } else {
            Option::<_>::none()
        }
    }
    pub fn last_ref(s: &Slice<T>) -> Option<&T> {
        if s.length == 0 {
            return Option::<_>::none();
        };
        s.get_ref(s.length - 1)
    }

    pub fn slice(s: &Slice<T>) -> Slice<T> {
        s.slice_range(0, s.length)
    }

    pub fn slice_range(s: &Slice<T>, from: usize, to: usize) -> Slice<T> {
        if to < from { panic("Slice range negative") };
        if s.length < to { panic("Slice out of range for vector") };
        _ { buffer: std::mem::arr_offset(s.buffer, from), length: to - from }
    }

    pub fn iter(self: &Slice<T>) -> SliceIter<T> {
        _ { length: self.length, buffer: self.buffer, index: 0 }
    }
}

impl<T: Copy> Slice<T> {
    pub fn copy_iter(self: &Slice<T>) -> SliceCopyIter<T> {
        _ { length: self.length, buffer: self.buffer, index: 0 }
    }
}

impl<T: Cmp> Slice<T> {
    pub fn sort(s: &Slice<T>) {
        s.sort_with(T::<>::cmp);
    }
}

impl<T> Slice<T> {
    pub fn sort_with(s: &Slice<T>, comparator: function_ptr<i32>) {
        if s.length <= 1 {
            return;
        };
        let pivot = std::mem::take_unchecked(s.get_ref(numcast(c_api::rand64()) % s.length).unwrap());
        let a = 0usize;
        let b = s.length - 1;
        let homogeneous = true;
        while a != b {
            let item = s.get_ref(a).unwrap();
            let r = (comparator)(item, &pivot);
            homogeneous &= r == 0;
            if r <= 0 { // item is smaller  or equal to pivot
                a += 1;
            } else { // item is bigger than pivot
                std::mem::swap(item, s.get_ref(b).unwrap());
                b -= 1;
            }
        };
        std::mem::forget(pivot);
        if homogeneous {
            return;
        };
        let left = s.slice_range(0, a+1);
        let right = s.slice_range(a, s.length);
        left.sort_with(comparator);
        right.sort_with(comparator);
    }
}

use core::eq::Eq;

impl<T: Eq> Slice<T> {
    fn split(self: &Slice<T>, delimeter: &T) -> Spliterator<T> {
        _ { length: self.length, index: 0, buffer: self.buffer, delimeter: delimeter }
    }
}

pub struct Spliterator<T: Eq> {
    length: usize, 
    index: usize,
    buffer: &T,
    delimeter: &T
}

impl<T: Eq> Spliterator<T>: Iter<Slice<T>> {
    fn next(self: &Spliterator<T>) -> Option<Slice<T>> {
        if self.index < self.length {
            let start = self.index;
            while self.index < self.length && std::mem::arr_offset(self.buffer, self.index).eq(self.delimeter) == false {
                self.index += 1;
            };
            self.index += 1;
            Option::<_>::some(Slice { 
                buffer: std::mem::arr_offset(self.buffer, start),
                length: self.index - start - 1
            })
        } else {
            Option::<_>::none()
        }
    }
}

impl Slice<char> {
    pub fn from_c_str(s: c_str) -> Slice<char> {
        let length = c_api::str::strlen(s);
        _ {
            length: length,
            buffer: typecast(s)
        }
    }

    fn dyn_fmt_str(s: &Slice<char>) -> DynFmt {
        _ { object: typecast(s), fmt: Slice::<char>::fmt_str }
    }
    fn fmt_str(s: &Slice<char>, fmt: &Formatter, stream: &FormatStream) {
        let i = 0usize;
        while i < s.length {
            stream.write_char(s.get(i).unwrap());
            i += 1;
        };
    }
}

use std::fmt::*;

impl<T: Fmt> Slice<T>: Fmt {
    fn dyn_fmt(s: &Slice<T>) -> DynFmt {
        _ { object: typecast(s), fmt: Slice::<T>::fmt }
    }
    fn fmt(s: &Slice<T>, fmt: &Formatter, stream: &FormatStream) {
        stream.write_str("[");
        let i = 0usize;
        while i < s.length {
            if i > 0 { stream.write_str(", "); };
            s.get_ref(i).unwrap().fmt(fmt, stream);
            i += 1;
        };
        stream.write_str("]");
    }
}

impl<T: Copy> Slice<T> {
    pub fn last(s: &Slice<T>) -> Option<T> {
        if s.length == 0 {
            return Option::<_>::none();
        };
        s.get(s.length - 1)
    }

    pub fn get(s: &Slice<T>, i: usize) -> Option<T> {
        if i < s.length {
            Option::<_>::some(*std::mem::arr_offset(s.buffer, i))
        } else {
            Option::<_>::none()
        }
    }
}

impl<T: Clone> Slice<T> {
    pub fn to_vec(self: &Slice<T>) -> Vec<T> {
        let cloned = Vec::<T>::new_with(self.length);
        while cloned.length < self.length {
            cloned.push(self.get_ref(cloned.length).unwrap().clone());
        };
        cloned
    }
}

impl<T: Copy> Slice<T> {
    pub fn to_vec(self: &Slice<T>) -> Vec<T> {
        let cloned = Vec::<T>::new_with(self.length);
        while cloned.length < self.length {
            cloned.push(self.get(cloned.length).unwrap());
        };
        cloned
    }
}